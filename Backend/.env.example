# Server
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
NODE_ENV=development
# Prisma
DATABASE_URL="mysql://your_database_user:your_database_password@localhost:3306/your_database_name"

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Bcrypt
BCRYPT_SALT_ROUNDS=10

#smtp configuration 
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=yourgmail@gmail.com
MAIL_PASS=abcdefghijklmnop
MAIL_FROM="Synapse <yourgmail@gmail.com>"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

HF_API_KEY=
HF_MODEL=
HF_BASE_URL=https://router.huggingface.co/v1/chat/completions